# İkisi de boşsa site DEMO verisiyle çalışır. Gerçek anahtarları .env.local dosyasına yazın.

# https://www.football-data.org — Avrupa ligleri, istatistik ve öneriler (ücretsiz plan yeterli).
FOOTBALL_DATA_KEY=

# https://www.api-football.com — Süper Lig, 1. Lig, Avrupa Ligi, Konferans Ligi.
# Ücretsiz planda yalnızca dün/bugün/yarının maç listesi gelir.
API_FOOTBALL_KEY=
# Ücretli plana geçince 1 yapın; bu liglerde de istatistik ve öneri açılır.
API_FOOTBALL_PAID=0
